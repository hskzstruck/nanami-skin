  "tokenColors": [
    {
      "scope": ["source", "text"],
      "settings": { "foreground": "#D8CECB" }
    },
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#C9BCC2", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "#DFC58A" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character", "constant.other", "support.constant"],
      "settings": { "foreground": "#E4B69C" }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#EAB2AA" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": { "foreground": "#D64845" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type"],
      "settings": { "foreground": "#DFC58A" }
    },
    {
      "scope": ["entity.name.namespace", "entity.other.inherited-class", "support.module"],
      "settings": { "foreground": "#DFC58A" }
    },
    {
      "scope": ["variable", "support.variable"],
      "settings": { "foreground": "#D8CECB" }
    },
    {
      "scope": ["variable.parameter", "variable.language"],
      "settings": { "foreground": "#D8CECB" }
    },
    {
      "scope": ["variable.other.property", "meta.object-literal.key"],
      "settings": { "foreground": "#DDB0B5" }
    },
    {
      "scope": ["entity.name.tag", "support.type.property-name", "entity.other.attribute-name"],
      "settings": { "foreground": "#DDB0B5" }
    },
    {
      "scope": ["punctuation", "meta.brace", "keyword.operator"],
      "settings": { "foreground": "#C5B8B5" }
    },
    {
      "scope": ["markup.heading", "markup.bold"],
      "settings": { "foreground": "#DFC58A" }
    },
    {
      "scope": ["markup.italic", "markup.quote"],
      "settings": { "foreground": "#C5B8B5" }
    },
    {
      "scope": ["markup.underline.link", "string.other.link", "meta.link"],
      "settings": { "foreground": "#DFC58A" }
    },
    {
      "scope": ["markup.inline.raw", "markup.fenced_code", "support"],
      "settings": { "foreground": "#D8CECB" }
    },
    {
      "scope": ["markup.inserted"],
      "settings": { "foreground": "#C5B8B5" }
    },
    {
      "scope": ["markup.deleted", "invalid", "invalid.illegal"],
      "settings": { "foreground": "#EAB2AA" }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#DFC58A",
    "struct": "#DFC58A",
    "class": "#DFC58A",
    "enum": "#DFC58A",
    "interface": "#DFC58A",
    "type": "#DFC58A",
    "typeParameter": "#DFC394",
    "function": "#D64845",
    "method": "#D64845",
    "macro": "#EAB2AA",
    "variable": "#D8CECB",
    "parameter": "#D8CECB",
    "property": "#DDB0B5",
    "property.readonly": "#E4B69C",
    "variable.readonly": "#DFC394",
    "enumMember": "#E4B69C",
    "event": "#DDB0B5"
  }
}
